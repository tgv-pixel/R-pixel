services:
  - type: web
    name: telegram-dating-bot
    env: python
    buildCommand: pip install -r requirements.txt
    startCommand: python server.py
    envVars:
      - key: BOT_TOKEN
        sync: false
      - key: ADMIN_IDS
        value: "YOUR_TELEGRAM_ID"
      - key: CBE_ACCOUNT
        value: "1000612391754"
      - key: TELE_BIRR_NUMBER
        value: "0940980555"
      - key: PAYMENT_AMOUNT
        value: "500"
      - key: RENDER
        value: "true"
      - key: WEBHOOK_URL
        sync: false
